NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Use 127.0.0.1 for local Postgres on Windows (avoids IPv6 ::1 when the server listens on IPv4 only).
#
# IMPORTANT — `docker compose` vs host API:
# - Values below (DB_HOST, DB_PORT, MQTT_BROKER_URL, INFLUX_URL) apply when you run the API on the HOST (`npm start`).
# - The `api` service in docker-compose.yml sets DB_HOST=db, INFLUX_URL=http://influxdb:8086 directly.
#   MQTT_BROKER_URL uses ${MQTT_BROKER_URL:-mqtt://mqtt:1883} — leave it commented below so Docker keeps the safe fallback.
# - If the API container logs `ECONNREFUSED 127.0.0.1:15432`, your compose file was overriding DB_* from .env — update compose.
#
# DB on host: `docker compose up -d db` maps Postgres to port 15432. If you use a local Postgres
# on 5432 instead, set DB_PORT=5432 (and matching DB_USER/DB_PASSWORD).
DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=smartpark
DB_USER=smartpark
DB_PASSWORD=smartpark

# Add-on Board: TTL (ms) for shared ride payload cache (summary / rides / critical / zone). Default 5000.
# ADDON_BOARD_CACHE_MS=8000

CORS_ORIGIN=*

# JWT signing (required in production — must match across instances)
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_DAYS=7

# Wave 2 — IoT. For MQTT messages to reach a broker:
MQTT_ENABLED=false
# MQTT_BROKER_URL=mqtt://127.0.0.1:1883 # Nur für Host-Dev einkommentieren. Docker nutzt automatisch den sicheren Fallback mqtt://mqtt:1883
MQTT_CLIENT_ID=smart-park-os-api
MQTT_USERNAME=smartpark
# Required in production (docker-compose.prod.yml). Dev compose keeps anonymous MQTT if unset.
MQTT_PASSWORD=
# Sequelize pool (optional; defaults max 20 / min 2)
# DB_POOL_MAX=20
# DB_POOL_MIN=2
# Reject ingested messages whose timestamp is older than this (ms, default 20m)
INGESTION_MAX_AGE_MS=1200000

# InfluxDB 2.x — optional OT historian for numeric Sparkplug DDATA (see docker-compose service `influxdb`, port 8086).
# INFLUX_ENABLED=true only enables the client (infrastructure). Actual writes require Admin → Platform Settings →
# Telemetry → "Stream OT & ML metrics to InfluxDB" (INFLUX_OT_STREAMING_ENABLED), or INFLUX_OT_STREAMING_ENABLED=true here.
# Default off. In Docker Compose, set INFLUX_ENABLED=true to match the init token below when the influxdb service is up.
#
# INFLUX_URL host MUST match where the API process runs:
# - Für Docker-Compose: fest `http://influxdb:8086` in docker-compose.yml (Service `influxdb`).
# - Für Host-Dev + `docker compose up -d influxdb` (Port 8086 gemappt):
INFLUX_ENABLED=false
INFLUX_URL=http://127.0.0.1:8086
INFLUX_TOKEN=smart-park-local-dev-influx-token-not-for-prod
INFLUX_ORG=smartpark
INFLUX_BUCKET=ot_metrics
# Only write when |new-old| > epsilon (0 = any change). Optional heartbeat: INFLUX_MIN_WRITE_INTERVAL_MS=60000
INFLUX_FLOAT_EPSILON=1e-9
INFLUX_MIN_WRITE_INTERVAL_MS=0
# Platform setting mirror (DB → ENV → default false). Prefer toggling in Admin → Platform Settings → Telemetry.
# INFLUX_OT_STREAMING_ENABLED=false

# UNS registry mirror: lazy sync on GET mirror/summary (ms). Full rebuild anytime: POST /api/v1/uns-registry/mirror/sync (iotOt.settings.read).
# UNS_REGISTRY_MIRROR_STALE_MS=120000
#
# UNS Spy (MQTT observe-only rows + discovery). Default off.
# UNS_SPY_ENABLED=false
# After ThemeParks entity sync, emit adapter-sourced discovery rows for UNS Spy inbox (additive). Default off.
# ADAPTER_DISCOVERY_SPY_ENABLED=false
# Reserved: gate MQTT live updates by capability (not enforced yet). Default off.
# MQTT_ENFORCE_CAPABILITIES=false

# Phase 13 — MQTT capability guard for inbound tpuns/ + spBv1.0/ (default off = no change).
# MQTT_CAPABILITY_GUARD_MODE=off
# MQTT_CAPABILITY_GUARD_MODE=warn_only
# MQTT_CAPABILITY_GUARD_MODE=enforce
# Optional pilot: comma-separated ride asset UUIDs; when set, only those rides are evaluated (others always ALLOW).
# MQTT_CAPABILITY_GUARD_ALLOWED_RIDE_IDS=

# Wave 3 — AI forecast baseline (Node). When enabled, samples zones and refreshes baseline forecasts on this interval.
AI_SAMPLING_ENABLED=false
AI_SAMPLING_INTERVAL_SECONDS=300

# ML / forecast phased roadmap (Phase 0+). All default false — no behavior change until phases wire consumers. See docs/architecture/ml-forecast-phased-roadmap.md
# ML_TRACE_ENABLED=false
# ML_PROFILE_ENABLED=false
# ML_FEATURE_WEIGHTS_ENABLED=false  # Phase 4: merge manual profile weights into ml_prediction_traces.weighted_feature_vector_json (trace only; does not change baseline forecast output)

# Open-Meteo production ingest (per active park with coordinates): weather_observations + optional feature snapshot rebuild.
# Set parks.latitude/longitude or PARK-type park_assets with lat/lon. Poll interval default 300s (5 min).
WEATHER_OPEN_METEO_ENABLED=false
WEATHER_OPEN_METEO_INTERVAL_SECONDS=300
# WEATHER_OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# WEATHER_OPEN_METEO_FETCH_RETRIES=3
# WEATHER_OPEN_METEO_RETRY_BASE_MS=500
# After successful ingest, call AiFeatureStoreService.buildSnapshots() (default on). Set false to skip.
# WEATHER_OPEN_METEO_REBUILD_SNAPSHOTS=true

# External provider integrations (canonical adapter pipeline)
EXTERNAL_PARK_DATA_ENABLED=false
EXTERNAL_PARK_DATA_POLL_INTERVAL_SECONDS=120
EXTERNAL_PARK_DATA_POLL_NEAR_5M_UTC=true
EXTERNAL_PARK_DATA_DEFAULT_PROVIDER=themeparks_wiki
# Installed adapter scheduler (uses per-adapter YAML scheduleCron; runs ACTIVE adapters only)
ADAPTER_SCHEDULER_ENABLED=false

# Per-adapter install YAML (configJson, contextJson, …). Default directory: ./data/adapter-install-config
# ADAPTER_INSTALL_CONFIG_DIR=

# Central NDJSON log for adapter issues (invalid config, poll errors, scheduler skips, MQTT publish failures).
# Default path: ./data/adapter-pipeline.log (gitignored via *.log). Set ADAPTER_PIPELINE_LOG_ENABLED=false to disable.
# ADAPTER_PIPELINE_LOG=data/adapter-pipeline.log
# ADAPTER_PIPELINE_LOG_ENABLED=true
# ADAPTER_PIPELINE_LOG_MAX_BYTES=5242880
# Max bytes read from end of log for GET /adapters/pipeline-log UI (default 2MB)
# ADAPTER_PIPELINE_LOG_TAIL_BYTES=2097152

# Optional: override school-holiday YAML directory for calendar_demand (default: ./data/calendar-holidays)
# CALENDAR_HOLIDAY_DATA_DIR=

# Phase 2 — adapter output encoders (comma-separated). Used when POST /integrations/output/encode omits profiles.
# Default practice: sparkplug_json,canonical_historian (add uns_json only if you need tpuns/ topics globally)
OUTPUT_PROFILES=
# Sparkplug B MQTT namespace (JSON-on-topic MVP: payload is JSON, not protobuf).
# When SPARKPLUG_GROUP_ID is empty, the API defaults the group segment to the UNS park slug (e.g. europa_park).
SPARKPLUG_GROUP_ID=
# Edge node id (4th path segment), e.g. park_gateway → spBv1.0/{group}/DDATA/park_gateway/{device}
SPARKPLUG_EDGE_NODE=park_gateway

# Phase 8 — registry MQTT publisher pilot (parallel to legacy publishing; pilot rides only).
# REGISTRY_PUBLISH_ENABLED=false
# REGISTRY_PUBLISH_MODE=dry_run
# parallel | dry_run
# REGISTRY_SPARKPLUG_FORMAT=json
# json | protobuf_ready (protobuf_ready skips Sparkplug wire publish; UNS still follows mode)
# REGISTRY_PUBLISH_ALLOWED_RIDE_IDS=

# Attraction OEE lab simulator (Sparkplug JSON MVP on existing MQTT client). Does not enable auto-start unless SIM_OEE_AUTO_START.
# SIM_* aliases are supported for convenience.
# SIM_OEE_ENABLED=true
# SIM_OEE_AUTO_START=false
# SIM_OEE_PARK_ID=europa_park
# SIM_PARK_ID=europa_park
# Do not use SIM_OEE_EDGE_NODE for routing: the simulator picks Sparkplug edge per ride from Park master_profile.sparkplug + asset zone (sparkplug-edge-resolver). To force one edge for all selected rides, POST .../attraction-oee/start with JSON { "edgeNodeId": "park_gateway" }.
# SIM_OEE_EDGE_NODE=…   # legacy / ignored for OEE sim MQTT path (see resolver + POST body edgeNodeId)
# SIM_EDGE_NODE=…
# SIM_OEE_PUBLISH_MS=3000
# SIM_PUBLISH_MS=3000
# SIM_OEE_ATTRACTIONS=blue_fire,silver_star
# SIM_ATTRACTIONS=blue_fire,silver_star
# SIM_OEE_SCENARIO=NORMAL_OPERATION
# SIM_SCENARIO=NORMAL_OPERATION
# SIM_OEE_RANDOM_SEED=42
# SIM_RANDOM_SEED=42
# SIM_OEE_MIRROR_DOWNTIME_DB=true
# Mirror ThemeParks adapter ride status (WAIT_TIME / ENTITY_STATUS) into asset_downtime_events only during scheduled park hours; set false to disable.
# ADAPTER_STATUS_MIRROR_OEE_DOWNTIME=true
# Extra per-ride OT-style Sparkplug metrics (lift motor, LSM, vibration, …). Set false to keep payloads smaller.
# SIM_OEE_OT_METRICS=true
# (default true) Mirror simulator downtime into asset_downtime_events so Platform OEE sees rows; set false to disable.
#
# REST (auth + permission simulator:run): POST /api/v1/simulator/attraction-oee/start|stop|scenario, GET .../status
#
# predictive_maintenance adapter — optional deterministic Sparkplug demo telemetry (adapter poll → OutputRouter only)
# PDM_DEMO_TELEMETRY_ENABLED=false
# PDM_DEMO_MAX_ASSETS=50
# PDM_DEMO_SPARKPLUG_EDGE_NODE=predictive_gateway

# Industrial Predictive Maintenance platform (health score, trends, failure modes, park operations board API).
# PDM_INDUSTRIAL_PLATFORM_ENABLED=true
# PDM_OPERATIONS_BOARD_ENABLED=true

# Integration Flow Engine (backend flow orchestration; /api/v1/integration-flows/*).
# Für Host-Dev: default off. Für Docker-Compose `api`: default true (siehe docker-compose.yml).
# INTEGRATION_FLOW_ENGINE_ENABLED=false
# Interval scheduler poll (requires engine on). Default off; poll interval default 30s.
# INTEGRATION_FLOW_SCHEDULER_ENABLED=false
# INTEGRATION_FLOW_SCHEDULER_POLL_SECONDS=30
# Max parallel flow runs in the API process worker queue (Compose default 3).
INTEGRATION_FLOW_CONCURRENCY=3
# PAYLOAD_TRANSFORM script mode (secure sandbox required; default off).
# INTEGRATION_FLOW_SCRIPT_NODE_ENABLED=false

# Governed Widget Runtime (/api/v1/widget-runtime/*, Widget Runtime Studio).
# Für Host-Dev: default off. Für Docker-Compose `api`: default true unless overridden.
# WIDGET_RUNTIME_ENABLED=true

# --- docker-compose.yml — api service (${VAR:-default} aus dieser Datei) ---
# Fest in compose (nicht aus .env): DB_HOST=db, DB_PORT=5432, INFLUX_URL=http://influxdb:8086
# MQTT_BROKER_URL: ${MQTT_BROKER_URL:-mqtt://mqtt:1883} — nur setzen wenn du vom Compose-Default abweichst
# Optional in root `.env` für Compose-Substitution (Werte unten = Compose-Defaults wenn Zeile aktiv):
# NODE_ENV=development
# PORT=3000
# LOG_LEVEL=info
# CORS_ORIGIN=*
# JWT_SECRET=change-me-in-production-use-long-random-string
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_DAYS=7
# MQTT_ENABLED=true
# MQTT_CLIENT_ID=smart-park-os-api
# INTEGRATION_FLOW_ENGINE_ENABLED=true
# INTEGRATION_FLOW_CONCURRENCY=3
# WIDGET_RUNTIME_ENABLED=true
# ML_TRACE_ENABLED=true
# ML_PROFILE_ENABLED=true
# ML_FEATURE_WEIGHTS_ENABLED=true
# WEATHER_OPEN_METEO_ENABLED=true
# WEATHER_OPEN_METEO_INTERVAL_SECONDS=300
# WEATHER_OPEN_METEO_REBUILD_SNAPSHOTS=true
# WEATHER_OPEN_METEO_FETCH_RETRIES=3
# WEATHER_OPEN_METEO_RETRY_BASE_MS=500
# INFLUX_ENABLED=false
# INFLUX_TOKEN=smart-park-local-dev-influx-token-not-for-prod
# INFLUX_ORG=smartpark
# INFLUX_BUCKET=ot_metrics
# INFLUX_FLOAT_EPSILON=1e-9
# INFLUX_MIN_WRITE_INTERVAL_MS=0

# Operations Facts layer (shared KPI resolution for Add-on Board + SQDC). See docs/architecture/operations-facts-layer.md
# OPERATIONS_FACTS_LIVE_WAIT_FRESH_MS=1200000
# OPERATIONS_FACTS_CANONICAL_LOOKBACK_H=48

# UNS Live / MQTT: subscribe to extra Sparkplug patterns (NBIRTH, NCMD, …) when true
# MQTT_SPARKPLUG_LIVE_SUBSCRIBE_ADVANCED=false

# Smoke scripts: optional internal park UUID (defaults to first park in DB)
# INTERNAL_PARK_ID=
# Phase 1 (mirror + Add-on Board rideOperations): npm run smoke:phase1-operations

# ML add-on board smoke: set SMOKE_ML_STRICT=1 to fail when recent ride snapshots are below threshold
# SMOKE_ML_STRICT=0
# SMOKE_ML_MIN_RIDE_SNAPSHOTS_24H=1

# Agent preflight: minimum rolling approval rate (applied / resolved write proposals, last 30d) for `approval_rate_gate`. 0–1, default 0.6.
# AGENT_APPROVAL_GATE_MIN=0.6