# Production / Docker: full origin of the Smart Park OS API (no trailing slash)
# Leave empty when using Vite dev/preview with proxy (default) — browser calls /api on the same
# host and Vite forwards to VITE_PROXY_API_TARGET (see vite.config.ts).
# Never set VITE_API_URL to the dev UI port (5173) or /api hits Vite and returns 404. If you must
# set an origin in dev, use the API only (e.g. http://localhost:3000), not the UI.
# VITE_API_URL=http://localhost:3000
#
# When the API runs elsewhere, point the dev proxy at it (defaults to http://localhost:3000):
# VITE_PROXY_API_TARGET=http://127.0.0.1:4000

# Add-on Board L3 pilot: Operations Facts (`GET /api/v1/operations-facts/parks/:parkId/rides/:rideId`) + legacy detail unchanged.
# Default false leaves dashboard behaviour unchanged.
# VITE_USE_OPERATIONS_FACTS_FOR_RIDE_DASHBOARD=false

# Add-on Board L3 — custom signal widgets (picker, draft, preview, promoted tiles). Build-time rollback only:
# set to false or omit to hide the block without changing API data. Not an “experiment” gate.
# VITE_ADDON_BOARD_SIGNAL_SOURCE_PICKER=false
#
# E2E (Playwright): when PLAYWRIGHT_START_WEB_SERVER=1, set PLAYWRIGHT_ADDON_BOARD_PICKER=1 so the spawned Vite dev
# server enables the bundle flag (see docs/validation/addon-board-signal-source-picker-qa.md).
# PLAYWRIGHT_ADDON_BOARD_PICKER=0
