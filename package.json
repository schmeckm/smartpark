{
  "name": "smart-park-os",
  "version": "0.1.0",
  "description": "Smart Park OS — AI-enabled operations backend MVP",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "wait:db": "node scripts/wait-for-postgres.js",
    "smoke:adapter-runtime": "node scripts/smoke-adapter-runtime.js",
    "smoke:weather-adapter": "node scripts/smoke-weather-adapter.js",
    "smoke:calendar-demand": "node scripts/smoke-calendar-demand.js",
    "smoke:ai-feature-x": "node scripts/smoke-ai-feature-x.js",
    "smoke:euromir-e2e": "node scripts/smoke-euromir-e2e.js",
    "smoke:ai-ml-chain": "node scripts/ai-ml-chain-smoke.mjs",
    "smoke:ride-ml-mask": "node --test src/services/ml/ride-ml-capability-mask.smoke.test.js src/services/ml/ride-ml-feature-mask.service.test.js src/services/ml/ride-ml-feature-signal-map.governance.test.js src/services/ml/ride-feature-vector.util.test.js",
    "smoke:wodan-e2e": "node scripts/smoke-wodan-e2e.js",
    "smoke:rides-e2e": "node scripts/smoke-ride-forecast-all.js",
    "smoke:ml-influence": "node scripts/smoke-ml-influence.js",
    "smoke:addon-board": "node scripts/smoke-addon-board.js",
    "smoke:phase1-operations": "node scripts/smoke-phase1-operations.js",
    "smoke:ml-addon-board": "node scripts/smoke-ml-addon-board.js",
    "migrate:adapter-install-yaml": "node scripts/migrate-adapter-install-to-yaml.js",
    "migrate:mdm-zones-to-park-zones": "node scripts/migrate-mdm-zones-to-park-zones.js",
    "migrate:europa-park-asset-zones": "node scripts/update-europa-park-asset-zones-from-thematic-table.js",
    "mdm:update-europapark-zones": "node scripts/update-europapark-asset-zones.js",
    "mdm:update-europapark-zones:dry-run": "node scripts/update-europapark-asset-zones.js --dry-run",
    "mdm:update-europapark-master-data": "node scripts/update-europapark-asset-master-data.js",
    "smoke:adapters": "node scripts/smoke-adapter-packages.js",
    "smoke:opcua-edge": "node scripts/smoke-opcua-edge-adapter.js",
    "seed:journey-events": "node scripts/seed-visitor-journey-events.js",
    "verify:rbac": "node scripts/verify-rbac-sync.js",
    "sync:rbac": "node scripts/sync-rbac-manifest.js",
    "print:version": "node -p \"require('./package.json').version\"",
    "release:draft": "node scripts/release-draft.mjs",
    "audit:routes": "node scripts/list-express-routes.mjs",
    "validate:openapi:parse": "node scripts/validate-openapi-parse.mjs",
    "validate:openapi:route-drift": "node scripts/check-openapi-route-drift.mjs",
    "check:openapi-drift": "node scripts/check-openapi-drift.mjs",
    "check:route-duplicates": "node scripts/check-route-duplicates.mjs",
    "check:root-mount-baseline": "node scripts/check-root-mount-baseline.mjs",
    "check:adapter-keys-baseline": "node scripts/check-adapter-keys-baseline.mjs",
    "check:orchestrator-provider-branches": "node scripts/check-orchestrator-provider-branches.mjs",
    "build:openapi": "node scripts/build-openapi.mjs",
    "check:openapi-build": "node scripts/build-openapi.mjs --check",
    "governance:ci": "npm run check:openapi-drift && npm run check:route-duplicates && npm run check:root-mount-baseline && npm run check:adapter-keys-baseline && npm run check:orchestrator-provider-branches && npm run check:openapi-build && npm run governance:ride-ml-signal-map",
    "governance:ride-ml-signal-map": "node --test src/services/ml/ride-ml-feature-signal-map.governance.test.js",
    "test": "node scripts/verify-rbac-sync.js && node --test --test-reporter=spec \"src/!(integration-tests)/**/*.test.js\" \"src/!(integration-tests)/**/*.test.mjs\" \"scripts/**/*.test.mjs\" \"tools/**/*.test.js\"",
    "test:asset-uns-live-bridge": "node --test --test-reporter=spec src/utils/uns-mqtt-live-signal-match.test.mjs",
    "test:integration": "node --test --test-reporter=spec \"src/integration-tests/**/*.test.js\" \"src/integration-tests/**/*.e2e.test.js\"",
    "test:integration:ml-observability": "node --test --test-reporter=spec src/integration-tests/ml/ml-forecast-observability.e2e.test.js",
    "test:watch": "node --test --watch \"src/!(integration-tests)/**/*.test.js\"",
    "lint": "eslint .",
    "test:e2e": "npm run test:e2e --prefix admin-dashboard"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@influxdata/influxdb-client": "^1.35.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.0.0",
    "http-errors": "^2.0.0",
    "joi": "^18.1.2",
    "jsonwebtoken": "^9.0.3",
    "mqtt": "^5.10.3",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "sequelize": "^6.37.5",
    "sequelize-cli": "^6.6.2",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "^0.18.5",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "nodemon": "^3.1.9",
    "proxyquire": "^2.1.3",
    "supertest": "^7.1.0"
  },
  "private": true
}
